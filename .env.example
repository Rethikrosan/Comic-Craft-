APP_NAME=ComicCraft
HOST=127.0.0.1
PORT=8000
DEBUG=true

GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Use "mock" for a no-key local smoke test; use "hf" for Hugging Face images.
IMAGE_BACKEND=mock
HF_API_KEY=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_PROVIDER=hf-inference

PANELS=5
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
IMAGE_STEPS=25
